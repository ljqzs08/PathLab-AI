{
  "name": "pathlab-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Deterministic BFS/A* learning with local evidence reflection and optional server-side DeepSeek review",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "build:html": "node scripts/build-standalone.mjs",
    "test:standalone": "npm run build:html && playwright test --config playwright.standalone.config.ts",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "check": "npm run typecheck && npm run lint && npm test",
    "test:browser": "playwright test",
    "inspect:bfs": "node --experimental-strip-types scripts/inspect-bfs.mjs",
    "inspect:compare": "node --experimental-strip-types scripts/inspect-comparison.mjs"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ajv": "8.20.0"
  }
}
