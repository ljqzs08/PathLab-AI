# Disabled until the owner configures credentials, budget and explicit data consent.
AI_ENABLED=false
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-flash
AI_API_KEY=
# Independent random access token, at least 32 characters; NEVER use the provider API key here.
AI_ACCESS_TOKEN=
# Exact browser origin; adjust the port if starting on another port.
AI_ALLOWED_ORIGIN=http://127.0.0.1:3000
AI_TIMEOUT_MS=8000
# Process lifetime attempt cap (including provider failures); restart resets this, NOT a money cap.
AI_MAX_REQUESTS=20
